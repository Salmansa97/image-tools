{
  "name": "image-tools",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/generate-sitemap.mjs && node scripts/write-404.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "preview": "npx --yes http-server dist/image-tools/browser -p 4300 -c-1",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "build:app": "ng build",
    "sitemap": "node scripts/generate-sitemap.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.29",
    "@tailwindcss/postcss": "^4.3.4",
    "jszip": "^3.10.2",
    "postcss": "^8.5.32",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "description": "Free, private, browser-based image compressor, resizer, cropper and converter built with Angular 21.",
  "engines": {
    "node": ">=20.19.0"
  }
}
